# Memory Guardian — Firebase configuration
# Copy this file to .env.local and fill in values from your Firebase console.
# If nothing is set, the app automatically runs in DEMO MODE (localStorage).
#
# SECURITY: only the PUBLIC Web SDK config goes here. Never add a legacy
# "database secret" or a service-account key — anything in a web app is public.

# --- Option A: Realtime Database (used by the Ever-Mind ESP32 pendant) ---
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=https://<project>-default-rtdb.<region>.firebasedatabase.app

# --- Option B: Firestore (leave DATABASE_URL empty) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Default pendant device id (optional, defaults to mg-demo-01)
VITE_DEFAULT_DEVICE_ID=mg-demo-01
